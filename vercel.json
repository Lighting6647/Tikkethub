{
  "version": 2,
  "rewrites": [
    {
      "source": "/manage",
      "destination": "/manage.html"
    },
    {
      "source": "/manage/",
      "destination": "/manage.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?_path=/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
