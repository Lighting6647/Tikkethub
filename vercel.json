{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/manage",
      "destination": "/manage.html"
    },
    {
      "source": "/manage/",
      "destination": "/manage.html"
    },
    {
      "source": "/admin",
      "destination": "/404"
    },
    {
      "source": "/admin.html",
      "destination": "/404"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
